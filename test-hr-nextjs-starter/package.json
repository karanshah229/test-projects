{
  "name": "nextjs-starter",
  "author": "Hackerrank",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.12.0",
    "yarn": ">=1.22.0",
    "npm": "please-use-yarn"
  },
  "scripts": {
    "postinstall": "next telemetry disable",
    "dev": "NEW_RELIC_ENABLED=false next dev -p ${PORT-8080}",
    "dev:debug": "NEW_RELIC_ENABLED=false NODE_OPTIONS='--inspect-brk' yarn dev",
    "build": "NODE_ENV=production next build",
    "start": "NODE_OPTIONS='-r @newrelic/next' NODE_ENV=production next start -p ${PORT-3000}",
    "build:profile": "next build --profile",
    "type-check": "tsc",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "test": "jest --silent",
    "test:loud": "jest",
    "test:ci": "jest --ci",
    "test:nocov": "yarn test --collect-coverage=false",
    "test:watch": "yarn test --watch",
    "test:update": "yarn test --updateSnapshot",
    "test:diff": "yarn test --changedSince=master",
    "test:debug": "TEST_ENV=true node --inspect-brk ./node_modules/.bin/jest --runInBand --watch --collect-coverage=false --silent",
    "prettier:check": "git diff --diff-filter=d --name-only master | grep -E '\\.(js|jsx|ts|tsx|json|yml|md|html)$' | xargs yarn prettier --check",
    "prettier:fix": "git diff --diff-filter=d --name-only master | grep -E '\\.(js|jsx|ts|tsx|json|yml|md|html)$' | xargs yarn prettier --write",
    "prettier-all": "git ls-files -X .prettierignore | grep -iv chart/ | grep -iv jenkinsfile | grep -E '\\.(js|jsx|ts|tsx|json|yml|md|html)$' | xargs yarn prettier --write",
    "validate-locales": "node scripts/validate-locales.js",
    "install:styles-intellisense": "code --install-extension ./node_modules/hrds-styles-intellisense/dist/intellisense.vsix"
  },
  "dependencies": {
    "@hackerrank/hrds-components": "^8.14.0",
    "@hackerrank/hrds-styles": "^4.7.2",
    "@newrelic/next": "^0.5.1",
    "@newrelic/pino-enricher": "^1.1.1",
    "@next/font": "^13.1.1",
    "@react-aria/ssr": "^3.4.1",
    "@reduxjs/toolkit": "^1.3.6",
    "hr-util": "^6.11.3",
    "i18next": "^22.4.9",
    "newrelic": "^10.2.0",
    "next": "^13.1.0",
    "next-i18next": "^13.0.3",
    "next-redux-wrapper": "^8.1.0",
    "pino": "^8.14.1",
    "pino-pretty": "^10.0.0",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-i18next": "^12.1.4",
    "react-redux": "^7.2.0",
    "ui-icons": "^1.6.23"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^13.1.1",
    "@next/env": "^13.1.1",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.0.0",
    "@types/jest": "^27.0.1",
    "@types/node": "^16.9.1",
    "@types/react": "^18.0.10",
    "@types/react-dom": "^18.0.5",
    "@types/react-redux": "^7.1.18",
    "@typescript-eslint/eslint-plugin": "^5.45.1",
    "@typescript-eslint/parser": "^5.45.1",
    "babel-plugin-module-resolver": "^4.1.0",
    "eslint": "^8.29.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-next": "13.0.6",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-react": "^7.31.11",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.3.1",
    "jest-environment-jsdom": "^29.3.1",
    "node-notifier": "^10.0.1",
    "pre-commit": "^1.2.2",
    "prettier": "^2.8.0",
    "prettier-config-hackerrank": "^2.0.0",
    "sass": "^1.57.1",
    "ts-jest": "^27.0.5",
    "ts-node": "^10.2.1",
    "typescript": "^4.3.4"
  },
  "nextBundleAnalysis": {
    "budget": null,
    "budgetPercentIncreaseRed": 20,
    "showDetails": true
  },
  "pre-commit": [
    "validate-locales",
    "prettier:fix",
    "lint:fix",
    "type-check"
  ]
}
