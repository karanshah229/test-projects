{
  "name": "skillup-frontend",
  "author": "Hackerrank",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.12.0",
    "yarn": ">=1.22.0",
    "npm": "please-use-yarn"
  },
  "scripts": {
    "clean:node_modules": "rm -rf node_modules",
    "postinstall": "next telemetry disable",
    "dev": "NEW_RELIC_ENABLED=false next dev -p ${PORT-8080}",
    "dev:debug": "NEW_RELIC_ENABLED=false NODE_OPTIONS='--inspect-brk' yarn dev",
    "build": "NODE_ENV=production BACKEND_URL='' next build",
    "start": "NODE_OPTIONS='-r @newrelic/next' NODE_ENV=production next start -p ${PORT-3000}",
    "build:profile": "next build --profile",
    "type-check": "tsc",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "test": "jest --silent",
    "test:loud": "jest",
    "test:ci": "jest --ci",
    "test:nocov": "yarn test --collect-coverage=false",
    "test:watch": "yarn test --watch",
    "test:update": "yarn test --updateSnapshot",
    "test:diff": "yarn test --changedSince=master",
    "test:debug": "TEST_ENV=true node --inspect-brk ./node_modules/.bin/jest --runInBand --watch --collect-coverage=false --silent",
    "prettier:check": "git diff --diff-filter=d --name-only master | grep -E '\\.(js|jsx|ts|tsx|json|yml|md|html|scss|css)$' | xargs yarn prettier --check",
    "prettier:fix": "git diff --diff-filter=d --name-only master | grep -E '\\.(js|jsx|ts|tsx|json|yml|md|html|scss|css)$' | xargs yarn prettier --write",
    "prettier-all": "git ls-files -X .prettierignore | grep -iv chart/ | grep -iv jenkinsfile | grep -E '\\.(js|jsx|ts|tsx|json|yml|md|html|scss|css)$' | xargs yarn prettier --write",
    "validate-locales": "node scripts/validate-locales.js",
    "install:styles-intellisense": "code --install-extension ./node_modules/hrds-styles-intellisense/dist/intellisense.vsix"
  },
  "dependencies": {
    "@hackerrank/hrds-components": "^9.26.2",
    "@hackerrank/hrds-icons": "^1.0.7",
    "@hackerrank/hrds-styles": "^4.12.16",
    "@lottiefiles/react-lottie-player": "^3.5.3",
    "@newrelic/next": "^0.4.0",
    "@newrelic/pino-enricher": "^1.1.1",
    "@react-aria/ssr": "^3.8.0",
    "@reduxjs/toolkit": "^1.9.7",
    "async-mutex": "^0.4.0",
    "dayjs": "^1.11.10",
    "highcharts": "^10.3.3",
    "highcharts-pattern-fill": "^3.0.3",
    "highcharts-react-official": "^3.2.1",
    "hr-util": "^7.0.3",
    "i18next": "^22.4.9",
    "lodash": "^4.17.21",
    "newrelic": "^9.15.0",
    "next": "^14.0.1",
    "next-i18next": "^13.2.0",
    "next-redux-wrapper": "^8.1.0",
    "pino": "^8.11.0",
    "pino-pretty": "^10.2.3",
    "query-string": "^8.1.0",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-i18next": "^12.1.4",
    "react-redux": "^7.2.0",
    "sharp": "^0.32.6",
    "ui-icons": "^1.6.25"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.0.3",
    "@next/env": "^13.1.1",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.5.8",
    "@types/lodash": "^4.14.200",
    "@types/node": "18.11.18",
    "@types/react": "^18.0.10",
    "@types/react-dom": "^18.2.15",
    "@types/react-redux": "^7.1.18",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "babel-plugin-module-resolver": "^4.1.0",
    "cross-fetch": "^4.0.0",
    "eslint": "^8.53.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-next": "13.0.6",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "hrds-styles-intellisense": "^1.0.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "msw": "^0.49.2",
    "node-notifier": "^10.0.1",
    "pre-commit": "^1.2.2",
    "prettier": "^2.8.0",
    "prettier-config-hackerrank": "^2.0.0",
    "sass": "^1.69.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.2.1",
    "typescript": "5.2.2"
  },
  "nextBundleAnalysis": {
    "budget": null,
    "budgetPercentIncreaseRed": 20,
    "showDetails": true
  },
  "pre-commit": [
    "validate-locales",
    "prettier:fix",
    "lint:fix",
    "type-check"
  ]
}
